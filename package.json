{
  "name": "@adel1ne/libs",
  "version": "1.1.0",
  "packageManager": "yarn@4.5.3",
  "description": "Общая библиотека: api-connectors, infrastructure, utils",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "jest"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./api-connectors": {
      "types": "./dist/api-connectors/index.d.ts",
      "default": "./dist/api-connectors/index.js"
    },
    "./infrastructure": {
      "types": "./dist/infrastructure/index.d.ts",
      "default": "./dist/infrastructure/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    }
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.48",
    "axios": "^1.13.4",
    "bullmq": "^5.67.2",
    "cron-parser": "^5.5.0",
    "dotenv": "^17.2.3",
    "eventemitter3": "^5.0.4",
    "fastify": "^5.7.4",
    "inversify": "^7.11.0",
    "ioredis": "^5.9.2",
    "joi": "^18.0.2",
    "jsonpath-plus": "^10.3.0",
    "mongoose": "^9.1.5",
    "pino": "^10.3.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^25.2.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
