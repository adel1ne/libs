{
  "name": "@adel1ne/libs",
  "version": "1.0.0",
  "packageManager": "yarn@4.5.3",
  "description": "Общая библиотека: api-connectors, infrastructure, utils",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "jest"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./api-connectors": {
      "types": "./dist/api-connectors/index.d.ts",
      "default": "./dist/api-connectors/index.js"
    },
    "./infrastructure": {
      "types": "./dist/infrastructure/index.d.ts",
      "default": "./dist/infrastructure/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    }
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.0",
    "axios": "^1.7.0",
    "bullmq": "^5.0.0",
    "cron-parser": "^4.9.0",
    "dotenv": "^16.4.0",
    "eventemitter3": "^5.0.0",
    "fastify": "^4.28.0",
    "inversify": "^6.0.0",
    "ioredis": "^5.4.0",
    "joi": "^18.0.1",
    "jsonpath-plus": "^9.0.0",
    "mongoose": "^8.0.0",
    "pino": "^9.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
